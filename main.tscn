theme_override_colors/font_color = Color(0.6, 0.6, 0.6, 1)
theme_override_font_sizes/font_size = 11
text = "Controls:
• WASD / Arrows: Move avatar (stone blocks)
• Left Click/Drag: Paint material
• Right Click: Erase cells
• E: Dig sand/water at avatar
• F: Place material at avatar
• Space: Toggle simulation
• S: Step single tick
• R: Reset level
• F5 / F9: Save / Load"
autowrap_mode = 2

